{
  "name": "semi-auto",
  "displayName": "semi-auto",
  "description": "Automatically adds a semicolon when creating a new line (unless Ctrl is held).",
  "icon": "icon.png",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "semi-auto.onEnter",
        "title": "Semi Auto: On Enter"
      },
      {
        "command": "semi-auto.onCtrlEnter",
        "title": "Semi Auto: On Ctrl+Enter"
      }
    ],
    "keybindings": [
      {
        "command": "semi-auto.onEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|javascript|java|c|cpp|csharp|php|swift|kotlin|dart|rust|go|objective-c|sql)$/"
      },
      {
        "command": "semi-auto.onCtrlEnter",
        "key": "ctrl+enter",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
